{
  "name": "routebudget-eu-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-content.mjs --out dist",
    "content:build": "npm run build",
    "content:verify": "node scripts/verify-calculators.mjs && node scripts/verify-generated.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:research-check": "node scripts/verify-research.mjs",
    "seo:content-check": "node scripts/verify-content.mjs",
    "seo:links": "node scripts/verify-generated.mjs --scope links",
    "seo:schema": "node scripts/verify-generated.mjs --scope schema",
    "seo:sitemap": "node scripts/verify-generated.mjs --scope sitemap",
    "seo:robots": "node scripts/verify-robots.mjs",
    "seo:hreflang": "node scripts/verify-generated.mjs --scope hreflang",
    "seo:performance": "node scripts/verify-performance-budget.mjs",
    "seo:build": "npm run build",
    "seo:report": "node scripts/verify-seo-reports.mjs",
    "seo:gsc-analyze": "node scripts/analyze-gsc-export.mjs",
    "seo:all": "npm run seo:build && npm run seo:performance && npm run seo:audit && npm run seo:research-check && npm run seo:content-check && npm run seo:links && npm run seo:schema && npm run seo:sitemap && npm run seo:robots && npm run seo:hreflang && npm run seo:report",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "npm run lint && npm run build && npm run seo:performance && npm run content:verify"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
