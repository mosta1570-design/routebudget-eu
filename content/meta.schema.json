{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routebudget.eu/content/meta.schema.json",
  "title": "RouteBudget EU content metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "kind",
    "locale",
    "status",
    "title",
    "description",
    "eyebrow",
    "published",
    "modified",
    "reviewed",
    "author",
    "reviewer",
    "primaryKeyword",
    "secondaryKeywords",
    "searchIntent",
    "cluster",
    "topics",
    "related",
    "relatedCalculator",
    "pillar",
    "calculatorId",
    "conversionIntent",
    "appFeature",
    "translationGroup",
    "canonical",
    "ogImage",
    "noindex",
    "sources",
    "changeSummary"
  ],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "kind": { "enum": ["pillar", "guide", "calculator", "comparison", "landing"] },
    "locale": { "enum": ["it", "en", "de", "fr", "pl", "ro", "ar"] },
    "status": { "enum": ["idea", "researching", "brief-ready", "drafting", "review", "approved", "published", "updating", "retired"] },
    "title": { "type": "string", "minLength": 10, "maxLength": 75 },
    "mobileH1": { "type": "string", "minLength": 10, "maxLength": 75 },
    "description": { "type": "string", "minLength": 70, "maxLength": 180 },
    "eyebrow": { "type": "string", "minLength": 3 },
    "published": { "type": "string", "format": "date" },
    "modified": { "type": "string", "format": "date" },
    "reviewed": { "type": "string", "format": "date" },
    "author": { "type": "string", "minLength": 2 },
    "reviewer": { "type": "string", "minLength": 2 },
    "primaryKeyword": { "type": "string", "minLength": 3 },
    "secondaryKeywords": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
    "searchIntent": { "type": "string", "minLength": 3 },
    "cluster": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "topics": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
    "related": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^(guide|calcolatori|confronti|landing):[a-z0-9]+(?:-[a-z0-9]+)*$" } },
    "relatedCalculator": { "type": ["string", "null"], "pattern": "^calcolatori:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "pillar": { "type": ["string", "null"], "pattern": "^guide:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "calculatorId": { "enum": ["cost-per-km", "fuel-trip", "fuel-surcharge", null] },
    "conversionIntent": { "enum": ["complete-trip", "pdf-quote", "add-trip-costs", "protect-margin", "unlimited"] },
    "appFeature": { "enum": ["complete-route-calculation", "cost-breakdown", "cost-scenarios", "fuel-estimate", "local-archive", "pdf-quote"] },
    "translationGroup": { "type": "string", "minLength": 3 },
    "canonical": { "type": "string", "pattern": "^/[a-z]{2}/.+/$" },
    "ogImage": { "type": "string", "pattern": "^/[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "noindex": { "type": "boolean" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 3 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "publishedOrUpdated": { "type": "string" },
          "geography": { "type": "string" },
          "accessedAt": { "type": "string", "format": "date" },
          "supports": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "changeSummary": { "type": "string", "minLength": 10 }
  }
}
