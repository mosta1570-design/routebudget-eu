{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routebudget.eu/content/publishing/publication-record.schema.json",
  "title": "RouteBudget publication record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contentId",
    "canonical",
    "audienceMarket",
    "changeScope",
    "intentOwner",
    "demandEvidenceId",
    "approvalId",
    "productProofIds",
    "primarySourceUrls"
  ],
  "properties": {
    "contentId": { "type": "string", "pattern": "^(guide|calcolatori|confronti|landing)/[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "canonical": { "type": "string", "pattern": "^/it/.+/$" },
    "audienceMarket": { "const": "IT" },
    "changeScope": { "enum": ["new-content", "substantive-update", "metadata-or-links"] },
    "intentOwner": { "type": "string", "minLength": 8 },
    "demandEvidenceId": { "type": "string", "minLength": 8 },
    "approvalId": { "type": "string", "pattern": "^review:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "productProofIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "primarySourceUrls": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    },
    "cannibalizationExemptions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(guide|calcolatori|confronti|landing)/[a-z0-9]+(?:-[a-z0-9]+)*$" }
    }
  }
}
