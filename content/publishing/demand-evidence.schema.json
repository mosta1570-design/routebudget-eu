{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routebudget.eu/content/publishing/demand-evidence.schema.json",
  "title": "RouteBudget Italian demand evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "locale", "market", "capturedAt", "candidates"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "locale": { "const": "it" },
    "market": { "const": "IT" },
    "capturedAt": { "type": "string", "format": "date" },
    "provider": { "type": "string", "minLength": 3 },
    "providers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
    "method": { "type": "object", "additionalProperties": true },
    "gscContext": { "type": "object", "additionalProperties": true },
    "rejectedCandidates": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "primaryKeyword", "canonical", "query", "signal", "volume", "decision"],
        "properties": {
          "id": { "type": "string", "pattern": "^demand:[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "primaryKeyword": { "type": "string", "minLength": 3 },
          "canonical": { "type": "string", "pattern": "^/it/.+/$" },
          "query": { "type": "string", "minLength": 3 },
          "requestUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "exactSuggestionReturned": { "type": ["boolean", "null"] },
          "returnedSuggestions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
          "rawResponse": { "type": "string", "minLength": 3 },
          "signal": { "type": "string", "minLength": 3 },
          "signalNote": { "type": "string", "minLength": 20 },
          "volume": { "type": ["number", "null"] },
          "decision": { "enum": ["publish", "update", "merge", "reject"] },
          "intentBoundary": { "type": "string", "minLength": 20 },
          "productFit": { "type": "string", "minLength": 20 },
          "productBoundary": { "type": "string", "minLength": 20 },
          "sourceUrls": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } }
        }
      }
    }
  }
}
